# Supabase Public Configuration (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase Server-Only Secret Configuration (NEVER expose to client / NEVER use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API Key (For later integration, server-only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Generate a long random value for external API access (keep server-only)
APP_API_KEY=replace-with-a-long-random-secret

# Optional persistence (keep service role key server-only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional signed webhook delivery after each generated paper
# WEBHOOK_URL=https://your-service.example/webhooks/question-papers
# WEBHOOK_SECRET=replace-with-a-long-random-secret
