# Supabase Public Configuration (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase Server-Only Secret Configuration (NEVER expose to client / NEVER use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API Key (For later integration, server-only)
GEMINI_API_KEY=your-gemini-api-key
